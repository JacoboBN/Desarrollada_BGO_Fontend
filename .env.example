# Frontend - ejemplo de variables de entorno
# El código lee process.env. Este .env no se carga automáticamente salvo que se añada dotenv u otro cargador.
# Puedes usarlo como documentación o definir estas variables en el sistema/script npm.

# Backend local:
BACKEND_URL=http://localhost:3000

# Si falta BACKEND_URL, el código usa:
# https://backend-factura-albaran.onrender.com

# Autenticación propia. Si no se define, se activa en producción/app empaquetada.
ENABLE_REFRESH_TOKENS=

# Borra sesiones guardadas al arrancar si vale true.
RESET_SESSION_ON_START=false

# Uploads a Google Drive
DRIVE_UPLOAD_TIMEOUT_MS=180000
DRIVE_UPLOAD_CONCURRENCY=3